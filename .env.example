# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# ABACATEPAY_API_KEY: Token de autenticação da AbacatePay (ex: aba_dev_... ou aba_live_...)
# Configure no Secrets Panel do AI Studio com a chave da sua conta AbacatePay.
ABACATEPAY_API_KEY=YOUR_ABACATEPAY_API_KEY_HERE

# SUPABASE_URL: URL do projeto Supabase
SUPABASE_URL=https://loueswohgxxhstqjmvgp.supabase.co

# SUPABASE_ANON_KEY: Chave anônima pública do Supabase (Project Settings > API > anon public)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE


